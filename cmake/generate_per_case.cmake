# generate_per_case.cmake
# Called: cmake -DLIST_FILE=<path> -DOUTPUT=<path> -DBINARY=<path> -P this_file
#
# Reads a test list (one "group:name" per line) and writes a CMake file
# containing one add_test() per case.

if(NOT DEFINED LIST_FILE OR NOT DEFINED OUTPUT OR NOT DEFINED BINARY)
    message(FATAL_ERROR "generate_per_case.cmake requires -DLIST_FILE, -DOUTPUT, -DBINARY")
endif()

file(READ "${LIST_FILE}" _content)
string(REPLACE "\n" ";" _tests "${_content}")

set(_cmake "## Auto-generated by ward: per-case ctest entries\n")
set(_count 0)
foreach(_test IN LISTS _tests)
    string(STRIP "${_test}" _test)
    if(NOT _test)
        continue()
    endif()
    # Colons are valid in ctest test names; use the raw "group:name" as-is.
    string(APPEND _cmake "add_test(NAME \"${_test}\" COMMAND \"${BINARY}\" --no-color --exact=${_test})\n")
    math(EXPR _count "${_count} + 1")
endforeach()

string(APPEND _cmake "## ${_count} per-case test(s) registered\n")
file(WRITE "${OUTPUT}" "${_cmake}")
